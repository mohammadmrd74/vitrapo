  users       users?     @relation(fields: [expertId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([applicantId, expertId])
  @@index([expertId])
}

model ticketExpert {
  id       Int      @id @default(autoincrement())
  ticketId Int?
  expertId Int?
