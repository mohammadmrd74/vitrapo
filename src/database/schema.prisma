/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model applicant {
  id                        Int                         @id @default(autoincrement())
  userId                    Int
  nationalId                String?                     @db.Char(10)
  destCountryId             Int?
  visaType                  applicant_visaType?
  fieldOfStudy              String?                     @db.VarChar(100)
  superVisorMobile          String?                     @db.VarChar(11)
  studyLanguage             String?                     @db.Char(2)
  fileNumber                String?                     @db.VarChar(100)
  grade                     String?                     @db.VarChar(50)
  telephone                 String?                     @db.VarChar(15)
  state                     String?                     @db.VarChar(20)
  city                      String?                     @db.VarChar(20)
  passportNumber            String?                     @db.VarChar(15)
  passportExpireDate        DateTime?                   @db.Timestamp(0)
  passportIssueDate         DateTime?                   @db.Timestamp(0)
  address                   String?                     @db.Text
  gender                    applicant_gender?
  createdAt                 DateTime                    @default(now()) @db.Timestamp(0)
  updatedAt                 DateTime?                   @db.Timestamp(0)
  users                     users                       @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "applicant_FK")
  applicantContractDocument applicantContractDocument[]
  contracts                 contracts[]
  installments              installments[]

  @@unique([userId, destCountryId, visaType], map: "applicant_UN")
  @@index([userId], map: "applicant_FK")
}

