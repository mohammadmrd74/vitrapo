/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model lastReadByUsers {
  id                        Int                        @id @default(autoincrement())
  userId                    Int?
  ACDId                     Int?
  installmentId             Int?
  ticketId                  Int?
  lastReadId                Int?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime?                 
  applicantContractDocument applicantContractDocument? @relation(fields: [ACDId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  installments              installments?              @relation(fields: [installmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tickets                   tickets?                   @relation(fields: [ticketId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([userId, ACDId])
  @@unique([userId, installmentId])
  @@unique([userId, ticketId])
  @@index([ACDId])
  @@index([installmentId])
  @@index([ticketId])
}

model applicantExpert {
