/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model users {
  id                                  Int                                @id @default(autoincrement())
  username                            String                             @unique
  password                            String                            
  smscode                             String?                           
  mobile                              String?                            @unique
  email                               String?                            @unique
  roleId                              Int?                               @default(1)
  name                                String?                           
  family                              String?                           
  profilePicture                      String?                           
  status                              Int?                               @default(0)
  masterId                            Int?
  smsTimeLeft                         DateTime?                         
  createdAt                           DateTime                           @default(now())
  updatedAt                           DateTime?                         
  applicant                           applicant[]
  applicant_applicant_sellerIdTousers applicant[]                        @relation("applicant_sellerIdTousers")
  applicantContractDocumentMessage    applicantContractDocumentMessage[]
  applicantExpert                     applicantExpert[]
  changepasswords                     changepasswords[]
  installmentMessages                 installmentMessages[]
  ticketExpert                        ticketExpert[]
  ticketMasseges                      ticketMasseges[]
  tickets                             tickets[]
  userNotification_NN                 userNotification_NN[]
  roles                               roles?                             @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users                               users?                             @relation("usersTousers", fields: [masterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_users                         users[]                            @relation("usersTousers")

  @@index([roleId])
