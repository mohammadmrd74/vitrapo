generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model ACDMessage {
  id        Int       @id @default(autoincrement())
  ACDId     Int
  userId    Int
  message   String?  
  createdAt DateTime  @default(now())
  updatedAt DateTime?
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model applicant {
  id                        Int                         @id @default(autoincrement())
  userId                    Int
  nationalId                String?                    
  destCountryId             Int?
  visaType                  String?
  fieldOfStudy              String?                    
  superVisorMobile          String?                    
  studyLanguage             String?                    
  fileNumber                String?                    
  grade                     String?                    
  telephone                 String?                    
  state                     String?                    
  city                      String?                    
  passportNumber            String?                    
  passportExpireDate        DateTime?                  
  passportIssueDate         DateTime?                  
  address                   String?                    
  gender                    String?
  isConfirmed               Boolean?                    @default(false)
  isAdminConfirmed          Boolean?                    @default(false)
  sellerId                  Int?
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime?                  
  users                     users                       @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  countries                 countries?                  @relation(fields: [destCountryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  seller                    users?                      @relation("applicant_sellerIdTousers", fields: [sellerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  applicantContractDocument applicantContractDocument[]
  applicantExpert           applicantExpert[]
  applicantInformation      applicantInformation[]
  contracts                 contracts[]
  installments              installments[]

  @@unique([userId, destCountryId, visaType])
  @@index([userId])
  @@index([destCountryId])
  @@index([sellerId])
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model applicantContractDocument {
  id                               Int                                        @id @default(autoincrement())
  applicantId                      Int
  contractId                       Int
  documentId                       Int
  original                         String?                                   
  translate                        String?                                   
  wantTranslate                    Int?                                       @default(0)
  status                           String?          @default("empty")
  createdAt                        DateTime                                   @default(now())
  updatedAt                        DateTime?                                 
  translateStatus                  String? @default("empty")
  applicant                        applicant                                  @relation(fields: [applicantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  contracts                        contracts                                  @relation(fields: [contractId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  documents                        documents                                  @relation(fields: [documentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  applicantContractDocumentMessage applicantContractDocumentMessage[]
  lastReadByUsers                  lastReadByUsers[]

  @@unique([applicantId, contractId, documentId])
  @@index([contractId])
  @@index([documentId])
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model applicantInformation {
  id                 Int                 @id @default(autoincrement())
  applicantId        Int
  contractId         Int
  dataGroupId        Int?
  values             String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime?          
  applicant          applicant           @relation(fields: [applicantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  applicantDataGroup applicantDataGroup? @relation(fields: [dataGroupId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([applicantId, contractId, dataGroupId])
  @@index([contractId])
  @@index([dataGroupId])
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model contracts {
  id                        Int                         @id @default(autoincrement())
  applicantId               Int
  title                     String?                    
  description               String?                    
  issueDate                 DateTime?                  
  executeDate               DateTime?                  
  image                     String?                    
  status                    String?                    
  totalPrice                Int?
  istallmetNumbers          Int?                       
  isMain                    Int                         @default(1)
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime?                  
  applicantContractDocument applicantContractDocument[]
  applicant                 applicant                   @relation(fields: [applicantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  installments              installments[]

  @@index([applicantId])
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model countries {
  id                 Int                  @id @default(autoincrement())
  code               String?             
  phoneCode          String?             
  threeDigitCode     String?             
  extraDetails       String?
  map                String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime?           
  applicant          applicant[]
  countryTranslation countryTranslation[]

  @@index([code])
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model countryTranslation {
  id           Int        @id @default(autoincrement())
  countryId    Int?
  languageId   Int?
  languageAbbr String?   
  name         String?   
  continent    String?   
  createdAt    DateTime   @default(now())
  updatedAt    DateTime? 
  countries    countries? @relation(fields: [countryId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([countryId, languageId])
  @@index([countryId])
  @@index([languageId])
  @@index([name])
  @@index([continent])
  @@index([languageId, countryId])
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model documents {
  id                        Int                         @id @default(autoincrement())
  docTitle                  String                      @unique
  docDescription            String?                    
  hasTranslate              Int                         @default(0)
  documentGroupId           Int?
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime?                  
  applicantContractDocument applicantContractDocument[]
  doumentGroups             doumentGroups?              @relation(fields: [documentGroupId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([documentGroupId])
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model installmentMessages {
  id            Int          @id @default(autoincrement())
  installmentId Int
  userId        Int
  message       String?     
  createdAt     DateTime     @default(now())
  updatedAt     DateTime?   
  installments  installments @relation(fields: [installmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users         users        @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([installmentId])
  @@index([userId])
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model installments {
  id                  Int                   @id @default(autoincrement())
  title               String?              
  contractId          Int
  applicantId         Int
  installmentNumber   Int                   @default(1)
  price               Decimal              
  priceCurrency       String               
  dueDate             DateTime?            
  deadLine            Int?                 
  documentFile        String?
  isMain              Int?                  @default(1)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime?            
  status              String?  @default("empty")
  installmentMessages installmentMessages[]
  contracts           contracts             @relation(fields: [contractId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  applicant           applicant             @relation(fields: [applicantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lastReadByUsers     lastReadByUsers[]

  @@unique([contractId, applicantId, installmentNumber, isMain])
  @@index([applicantId])
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model permissions {
  id                Int                 @id @default(autoincrement())
  name              String             
  path              String             
  method            String
  createdAt         DateTime            @default(now())
  updatedAt         DateTime?          
  rolePermission_NN rolePermission_NN[]

  @@unique([method, path])
  @@index([path, method])
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model rolePermission_NN {
  id           Int                      @id @default(autoincrement())
  roleId       Int
  permissionId Int
  status       String @default("enabled")
  expiredAt    DateTime?               
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime?               
  permissions  permissions              @relation(fields: [permissionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  roles        roles                    @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([permissionId, roleId])
  @@index([status, roleId])
  @@index([permissionId, status])
  @@index([roleId])
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model roles {
  id                Int                 @id @default(autoincrement())
  title             String              @unique
  createdAt         DateTime            @default(now())
  updatedAt         DateTime?          
  rolePermission_NN rolePermission_NN[]
  users             users[]
}

