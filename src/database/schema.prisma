  ticketMasseges  ticketMasseges[]
  ticketCategory  ticketCategory    @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users           users?            @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

